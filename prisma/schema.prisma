// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// ------------ CONFIGS --------------
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ------------ ENUMS --------------
// DB enum 타입 사용 x, 코드적으로 관리함.
enum AUTH_PROVIDER {
  // KAKAO
  GOOGLE
  // NAVER
  // APPLE
}

// DB enum 타입 사용 x, 코드적으로 관리함.
enum CURRENCY_CODE {
  KRW // 한국 (원)
}

// ------------ MODELS --------------
model user {
  id        String    @id @default(dbgenerated()) @db.Char(26)
  name      String    @db.VarChar(100)
  email     String    @unique @db.VarChar(200)
  timezone  String    @default("Asia/Seoul") @db.VarChar(50)
  currency  String    @default("KRW") @db.Char(3)
  birthDate DateTime? @map("birth_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  auths         user_auth[]
  accounts      account[]
  transactions  transaction[]
  categories    category[]
  refreshTokens refresh_token[]
}

model refresh_token {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  token     String    @db.Char(64) // SHA-256 해시화한 값
  userId    String    @map("user_id") @db.Char(26)
  deviceId  String    @map("device_id") @db.Char(36) // 플랫폼에서 생성한 UUID
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model user_auth {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     String   @map("user_id") @db.Char(26)
  provider   String   @db.VarChar(10) // AUTH_PROVIDER 타입값 따름
  providerId String   @map("provider_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, provider])
  @@index([userId])
}

model account {
  id        String   @id @default(dbgenerated()) @db.Char(26)
  groupType Int      @map("group_type") @db.UnsignedTinyInt // 0: 기본 계좌, 1: 저축 계좌, 2: 투자 계좌
  userId    String   @map("user_id") @db.Char(26)
  currency  String   @db.Char(3) // CURRENCY_CODE 따름
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions transaction[]

  @@unique([userId, groupType, currency])
}

model transaction {
  id              String   @id @default(dbgenerated()) @db.Char(26)
  userId          String   @map("user_id") @db.Char(26)
  type            Int      @map("type") @db.UnsignedTinyInt // 0: 수입, 1: 지출 (계좌에 해당하는 수입, 지출 여부)
  categoryId      String?  @map("category_id") @db.Char(26)
  accountId       String   @map("from_account_id") @db.Char(26)
  amount          Int
  currency        String   @db.Char(3) // CURRENCY_CODE 따름
  name            String   @db.VarChar(128)
  transactionDate DateTime @map("transaction_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, transactionDate])
}

model category {
  id              String @id @default(dbgenerated()) @db.Char(26)
  userId          String @map("user_id") @db.Char(26)
  groupType       Int    @map("group_type") @db.UnsignedTinyInt // 0: 기본 계좌, 1: 저축 계좌, 2: 투자 계좌
  transactionType Int    @map("transaction_type") @db.UnsignedInt // 0: 수입, 1: 지출 (계좌에 해당하는 수입, 지출 여부)
  iconKey         String @db.VarChar(100)
  iconColor       String @db.VarChar(30)
  name            String @db.VarChar(50)
  budget          Int?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions transaction[]

  @@unique([userId, name, groupType])
}
